# macOS / Python / pytest droppings.
.DS_Store
__pycache__/
.pytest_cache/

# Regenerable numeric artifacts. Every one is reproducible from the script
# that wrote it; committing them would put ~190 MB of derived data in history
# for no auditable gain. Where a specific run's bits are load-bearing, pin them
# with a checksum manifest instead (see
# experiments/overnight-arms/frontier_attack/a20_deep_simulation/CHECKSUMS.sha256).
*.npy
*.bin

# Editor and reparse backups.
*.bak

# Modal spend ledger. Operational state, not a record to publish: the charter's
# local-workflow section says it must not be committed if it carries remote
# invocation identifiers, and mark-submitted writes exactly those. Manifests,
# rate snapshots and result hashes are archived instead.
*.sqlite3

# LaTeX build products.
*.aux
*.fdb_latexmk
*.fls
*.out

# Vendored third-party source (cloned, not ours to version here).
experiments/openevolve-p3/vendor/
experiments/openevolve-p3/openevolve_output*/

# Experiment-local build products and restart caches.  Sources, compact JSON
# results, checksums and human-readable reports remain versioned.
experiments/overnight-arms/frontier_attack/a25_checkerboard_growth_extended/cache/
experiments/overnight-arms/frontier_attack/a25_checkerboard_growth_extended/band30
experiments/overnight-arms/frontier_attack/a25_checkerboard_growth_extended/band30_scalar
experiments/rule30-subword-extended/analyze
experiments/rule30-subword-extended/equiv_check
experiments/rule30-subword-extended/gen30
experiments/rule30-subword-extended/gen30v2
experiments/rule30-subword-extended/gen30v3
experiments/rule30-subword-extended/gen30v4

# Regenerable SAT instances and DRUP traces for the period-two mortality
# experiment.  Compact profiles/results and the independent checker are
# versioned; checked raw certificates remain local because they total ~14 MiB.
experiments/rule30/p1-period2-invariant/mortality-proofs/
experiments/rule30/p1-period2-invariant/mortality-threshold-proofs/
